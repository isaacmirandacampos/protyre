# Prismic Configuration
# Repository name (automatically read from slicemachine.config.json)
# PRISMIC_REPOSITORY_NAME=protyre

# Prismic Write API Token (required for Live Editing)
# Get this from: https://protyre.prismic.io/settings/apps/
# Settings -> API & Security -> Generate an Access Token (with write access)
PRISMIC_WRITE_TOKEN=your_write_token_here

# RESEND is the provider to send e-mail
RESEND_API_KEY=
